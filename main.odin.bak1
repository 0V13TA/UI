package UI

main :: proc() {
	app := app_init("Textarea", 500, 600, {.SHOWN, .ALLOW_HIGHDPI})
	if app == nil do return
	defer app_destroy(app)

	buffer: Gap_Buffer
	gap_buffer_init(&buffer)
	defer gap_buffer_delete(&buffer)

	for !app.quit {
		app_begin_frame(app)
		defer app_end_frame(app)

		textarea(
			app,
			&buffer,
			"Text Area",
			wrapper_style = {width = ViewPercent{60}, height = ViewPercent{60}},
		)
	}
}
